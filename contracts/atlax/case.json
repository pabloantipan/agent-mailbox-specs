{
  "contract": "atlax",
  "description": "The file shapes of atlax, the platform's copy of the Atlas norm (~/agent-slack/docs/atlas/manifesto.md; implementation.md steps 1-2 and Layout; decisions.md 2026-10-31). Every sample below holds to its schema; test.py checks each, and a missing sample or schema fails, never skips. The example artifact is the mailbox (agent-slack); the example consumer is Deltagos (organizer).",
  "samples": [
    {"sample": "element.sample.yaml", "schema": "element.schema.json", "what": "one element file, atlax/elements/<designation>.yaml in an artifact repo"},
    {"sample": "element-consumer.sample.yaml", "schema": "element.schema.json", "what": "an element in another artifact whose consumes: reads ext:agent-slack#fn:mailbox.threads.list"},
    {"sample": "plant.sample.yaml", "schema": "plant.schema.json", "what": "atlax/plant.yaml, the artifact's nameplate"},
    {"sample": "published/agent-slack/PUBLISHED", "schema": "published.schema.json", "what": "the stamp of a published folder"},
    {"sample": "published/agent-slack/plant.yaml", "schema": "plant.schema.json", "what": "the nameplate as published", "equals": "plant.sample.yaml"},
    {"sample": "published/agent-slack/elements/fn.mailbox.threads.list.yaml", "schema": "element.schema.json", "what": "a published element (http, authored, live)", "equals": "element.sample.yaml"},
    {"sample": "published/agent-slack/elements/fn.mailbox.health.yaml", "schema": "element.schema.json", "what": "a published element (http, authored, live)"},
    {"sample": "published/agent-slack/elements/rule.push-retry.yaml", "schema": "element.schema.json", "what": "a published rule: R1 (429) live, R2 (503) planned, each naming its test"},
    {"sample": "published/agent-slack/derived/map.json", "schema": "../c4-map/map.schema.json", "what": "derived/map.json, c4-map gen's output at the published sha (c4-map/1, unchanged)"},
    {"sample": "claim.sample.json", "schema": "claim.schema.json", "what": "the body a starting card posts to Hestia's claims"},
    {"sample": "verify-findings.sample.json", "schema": "verify-findings.schema.json", "what": "atlax verify --json: redline, shadow, book-guard, row-test, ext-break"},
    {"sample": "check-findings.sample.json", "schema": "check-findings.schema.json", "what": "atlax check --json: ext-break, consumer-notice"}
  ],
  "published_folder": {
    "path": "published/agent-slack",
    "required": ["PUBLISHED", "plant.yaml", "elements", "derived/map.json"],
    "element_file_name": "the designation with ':' written '.', plus .yaml",
    "lands_at": "artifacts/<artifact>/ in the atlax repo (ATLAX_REPO, cloned at ATLAX_DIR)"
  },
  "writers": [
    "the artifact's FSE, Daedalus and builders: element files and plant.yaml, through a card's change order",
    "claudecode bin/atlax (card atlax-tool): PUBLISHED, derived/, verify and check findings",
    "the card's start (factory side): the claim"
  ],
  "readers": [
    "claudecode bin/atlax verify, publish, check (card atlax-tool T1-T7): no test reads this folder yet",
    "Hestia's claims API (a Hestia card): no test reads claim.sample.json yet",
    "atlax-agent, the Deltagos map lens, Elenx C4, Daedalus: no test reads it yet"
  ],
  "must_refuse": [
    {"schema": "element.schema.json", "reason": "the IEC symbol is never written: one spelling (decisions.md 2026-10-31, item 2)",
     "case": {"designation": "=BILLING.ISSUE", "kind": "http", "authored": false, "lifecycle": "live", "owner": "x", "terminal": {"method": "GET", "path": "/x"}}},
    {"schema": "element.schema.json", "reason": "an authored terminal names its contract sample and its test",
     "case": {"designation": "fn:mailbox.threads.list", "kind": "http", "authored": true, "lifecycle": "live", "owner": "hephaistos", "terminal": {"method": "GET", "path": "/projects/{pid}/threads"}}},
    {"schema": "element.schema.json", "reason": "every row of a rule names its test",
     "case": {"designation": "rule.push-retry", "kind": "rule", "authored": true, "lifecycle": "planned", "owner": "hephaistos", "rows": [{"row": "R2", "when": {"status": 503}, "then": "wait", "lifecycle": "planned"}]}},
    {"schema": "element.schema.json", "reason": "maturity is binary (authored) for now; no middle levels",
     "case": {"designation": "fn:mailbox.health", "kind": "http", "authored": false, "maturity": "stable", "lifecycle": "live", "owner": "x", "terminal": {"method": "GET", "path": "/x"}}},
    {"schema": "element.schema.json", "reason": "consumes: is ext:<artifact>#<designation>",
     "case": {"designation": "prod:organizer.discuss.ThreadsByStatus", "kind": "outbound", "authored": false, "lifecycle": "live", "owner": "x", "terminal": {"method": "GET", "path": "/x"}, "consumes": ["fn:mailbox.threads.list"]}},
    {"schema": "plant.schema.json", "reason": "an instance declares the norm it follows",
     "case": {"artifact": "agent-slack", "owner": "hephaistos"}},
    {"schema": "published.schema.json", "reason": "a short sha cannot be compared with main",
     "case": {"repo": "github.com/pabloantipan/agent-slack", "sha": "50de4f2", "time": "2026-10-31T23:40:12Z", "factory": "lodestar"}},
    {"schema": "claim.schema.json", "reason": "Hestia holds names only, never element content",
     "case": {"card": "agent-slack/thread-list-tags", "factory": "lodestar", "artifact": "agent-slack", "designations": [{"designation": "fn:mailbox.threads.list", "kind": "http"}]}},
    {"schema": "claim.schema.json", "reason": "Hestia holds names only, never element content",
     "case": {"card": "agent-slack/thread-list-tags", "factory": "lodestar", "artifact": "agent-slack", "designations": ["fn:mailbox.threads.list"], "elements": {"fn:mailbox.threads.list": {"lifecycle": "live"}}}},
    {"schema": "verify-findings.schema.json", "reason": "a row-test finding names its row, test and result",
     "case": {"schema": "atlax-verify/1", "artifact": "agent-slack", "card": "agent-slack/x", "base": "origin/main", "base_sha": "50de4f29ff59cb8db0ff80b5777bfbafd986e204", "head_sha": "50de4f29ff59cb8db0ff80b5777bfbafd986e204", "change_order": {"modifies": [], "adds": [], "retires": [], "frozen_at": "2026-11-02T14:05:00Z"}, "exit": 0, "findings": [{"kind": "row-test", "blocking": false, "designation": "rule.push-retry", "message": "R1"}]}},
    {"schema": "check-findings.schema.json", "reason": "check never raises verify's kinds",
     "case": {"schema": "atlax-check/1", "atlax_sha": "c7e2b9a4f1d6083e5a2c7b4f9d1e6a3c8b5f2d07", "artifacts": {}, "exit": 1, "findings": [{"kind": "redline", "blocking": true, "designation": "fn:mailbox.health", "message": "x"}]}}
  ]
}
